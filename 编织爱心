*/ 主循环 
tracks = [Track() for _ in range(TRACKS)]
beads = [Bead(random.choice(tracks)) for _ in range(90)]
flicks = [Flick() for _ in range(40)]
start = pygame.time.get_ticks() / 1000.0
running = True

while running:
    # 半透明黑底 -> 光轨残影（编织感的关键）
    fade = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
    fade.fill((0, 0, 0, 16))
    screen.blit(fade, (0, 0))

    t = pygame.time.get_ticks() / 1000.0 - start
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        elif event.type == pygame.KEYDOWN and event.key == pygame.K_SPACE:
            tracks = [Track() for _ in range(TRACKS)]
            beads = [Bead(random.choice(tracks)) for _ in range(90)]
            flicks = [Flick() for _ in range(40)]

    for sx, sy, a in stars:
        pygame.draw.circle(screen, (a, a, a+12), (sx, sy), 1)

    draw_tip_glow(t)

    for f in flicks:
        f.update_draw()
    for tr in tracks:
        tr.update_draw()
    for b in beads:
        b.update_draw()

    pygame.display.flip()
    clock.tick(60)

pygame.quit()
