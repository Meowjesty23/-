*/从尖端甩出的少量细射线 
class Flick:
    def __init__(self):
        self.reset()
    def reset(self):
        self.angle = random.uniform(math.pi*1.05, math.pi*1.95)  # 向下/侧方
        self.len = random.uniform(20, 90)
        self.grown = 0
        self.speed = random.uniform(2, 6)
        self.life = 255
    def update_draw(self):
        if self.grown < self.len:
            self.grown += self.speed
        else:
            self.life -= 10
        if self.life <= 0:
            self.reset()
        k = max(0, self.life/255)
        ex = TIPX + math.cos(self.angle) * self.grown
        ey = TIPY + math.sin(self.angle) * self.grown
        c = (int(190*k), int(160*k), int(235*k))
        pygame.draw.line(screen, c, (TIPX, TIPY), (ex, ey), 1)
        if k > 0.3:
            pygame.draw.circle(screen, (235, 225, 255), (int(ex), int(ey)), 1)

